# Bu dosyayı kopyalayip ".env" adiyla kaydet ve gercek degerlerini gir.
# ".env" dosyasi .gitignore'da oldugu icin asla git'e commit edilmez.

# Arc Testnet RPC endpoint (dogrulandi)
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# SADECE TESTNET icin kullanilacak bos/test bir cuzdanin private key'i.
# Gercek fonu olan bir cuzdanin private key'ini ASLA buraya yazma.
PRIVATE_KEY=0xyour_testnet_only_private_key_here

# Arc Testnet USDC (ERC-20 arayuzu, 6 decimal)
USDC_ADDRESS=0x3600000000000000000000000000000000000000
